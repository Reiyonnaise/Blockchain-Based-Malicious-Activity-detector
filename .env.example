# ==============================================================================
# Blockchain-Based Malicious Activity Detector (BlockSecure) - Environment Variables
# Copy this file to .env.local and populate the values for your environment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Ethereum Blockchain Configuration (Sepolia Testnet)
# ------------------------------------------------------------------------------
# Server-side RPC URL for submitting security audit transactions
ETHEREUM_RPC_URL=https://sepolia.infura.io/v3/your_infura_api_key

# Public RPC URL accessible by browser clients to read audit logs
NEXT_PUBLIC_ETHEREUM_RPC_URL=https://rpc.sepolia.org

# Private key of the deployer/operator wallet with Sepolia ETH for gas fees
# (Do NOT include '0x' prefix; NEVER commit actual keys to version control!)
PRIVATE_KEY=your_ethereum_wallet_private_key_without_0x

# Deployed SecurityLogger smart contract address on Sepolia testnet
NEXT_PUBLIC_CONTRACT_ADDRESS=0x803cd1bC1c06e64Ff4Cbd53bA4790844782A28d5

# ------------------------------------------------------------------------------
# 2. EmailJS Alert Service Configuration
# ------------------------------------------------------------------------------
# EmailJS service ID connected to your email provider (e.g., Gmail)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_your_service_id

# EmailJS template ID configured with parameters: event_type, severity, user_email, blockchain_hash
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_your_template_id

# EmailJS Public Key from Account Settings
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_emailjs_public_key

# Target Administrator Email address for real-time security alerts
NEXT_PUBLIC_ADMIN_EMAIL=admin@secureblock.com

# ------------------------------------------------------------------------------
# 3. Cloudinary Secure Storage (Optional - For File Uploads)
# ------------------------------------------------------------------------------
# Cloudinary cloud name
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name

# Cloudinary API credentials for signed uploads & file verification
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# ------------------------------------------------------------------------------
# 4. Firebase Configuration (Optional Overrides)
# ------------------------------------------------------------------------------
# If not provided, fallback credentials in lib/firebase.ts will be used.
# NEXT_PUBLIC_FIREBASE_API_KEY=your_firebase_api_key
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=your_project_id
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
# NEXT_PUBLIC_FIREBASE_APP_ID=your_app_id
